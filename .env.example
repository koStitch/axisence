# Template for .env: copy it to .env and replace each "replace-with-..." value.
# Compose passes every variable in .env to the db and web services.

# Django secret key. Required.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
# Turns on Django debug mode when "true". Optional, defaults to false. Local development only.
DJANGO_DEBUG=true
# Comma-separated host names Django serves. Optional, defaults to none.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Console logging level for every logger, Django's own included, except Django's SQL logger, which stays at INFO. Optional, defaults to INFO.
DJANGO_LOG_LEVEL=INFO
# Turns on Django's HTTPS settings for running behind a proxy that terminates HTTPS: it
# trusts X-Forwarded-Proto, redirects to HTTPS, marks cookies secure, and sends HSTS.
# Optional, defaults to false. The live copy only: the development copy has no proxy.
DJANGO_BEHIND_HTTPS_PROXY=false
# Database host. Required. "db" is the Compose database service.
POSTGRES_HOST=db
# Database port. Optional, defaults to 5432.
POSTGRES_PORT=5432
# Database name. Required. The PostGIS image creates it on its first start.
POSTGRES_DB=axisence
# Database user. Required. The PostGIS image creates it as the superuser on its first start.
POSTGRES_USER=axisence
# Database password. Required. The PostGIS image sets it on its first start.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Socrata app token sent as X-App-Token to data.ny.gov and data.cityofnewyork.us. Optional,
# defaults to none: without one, requests share the anonymous throttling pool.
SOCRATA_APP_TOKEN=
# US Census Data API key. Optional at startup; the Census demographics and boundaries
# commands require it. Request one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Axisence's website, a link in every teaser's call to action. Optional at startup; generating a
# teaser requires it. Must start with https://, for example https://www.example.com
AXISENCE_WEBSITE_URL=
# Axisence's email address for prospects, a link in every teaser's call to action. Optional at
# startup; generating a teaser requires it. For example hello@example.com
AXISENCE_CONTACT_EMAIL=
# Axisence's phone number for prospects, printed exactly as written. Optional at startup;
# generating a teaser requires it. For example (555) 010-0100
AXISENCE_CONTACT_PHONE=
# Token of the Cloudflare tunnel that publishes the live copy, from the tunnel's page in
# the Cloudflare dashboard. Read by compose.live.yaml only; the development copy leaves
# it blank.
CLOUDFLARE_TUNNEL_TOKEN=
# Makes every docker compose command in this folder use compose.live.yaml. The live copy
# only: uncomment it there, and leave it commented in the development copy.
# COMPOSE_FILE=compose.live.yaml
